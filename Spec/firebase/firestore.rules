rules_version = '2';

// 스키마 문서: spec/data/10-firestore-schema.md
// 원칙: 원장(trips)은 필드만 채워가는 구조 — 생성 후 legs/createdAt 불변, 전체 덮어쓰기 금지.
// 현재 단계는 "기록만 쌓기"이므로 utv/current, countries, tagVocabulary는 클라이언트 쓰기 전면 차단.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---------- 전역 (읽기 전용) ----------

    match /countries/{countryCode} {
      allow read: if isSignedIn();
      allow write: if false; // 시드/갱신은 Admin SDK로만
    }

    match /tagVocabulary/{tagId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---------- 유저 스코프 ----------

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /trips/{tripId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.legs.size() > 0
          && request.resource.data.status == 'planned';

        // 등록 사실은 불변. 상태·평가·랭킹 미러·대표 사진만 점진적으로 채운다.
        allow update: if isOwner(uid)
          && request.resource.data.legs == resource.data.legs
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'startedAt',
            'endedAt',
            'satisfaction',
            'wouldRepeat',
            'bestLegCountryCode',
            'comparison',
            'positiveTags',
            'negativeTags',
            'tagLegAttribution',
            'evalSource',
            'skipped',
            'rankPosition',
            'coverPhotoStoragePath',
            'evaluatedAt',
            'updatedAt'
          ]);

        allow delete: if false;
      }

      match /ranking/current {
        allow read, write: if isOwner(uid);
      }

      match /dailyPhotos/{photoId} {
        allow read, create: if isOwner(uid);
        allow update, delete: if false; // 기록용, 수정 불필요
      }

      match /cardFeedback/{feedbackId} {
        allow read, create: if isOwner(uid);
        // dislike 제외 해제만 허용. 원래 반응은 덮어쓰지 않는다.
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt']);
        allow delete: if false;
      }

      match /events/{eventId} {
        allow read, create: if isOwner(uid);
        allow update, delete: if false; // append-only 분석 로그
      }

      match /utv/current {
        allow read, write: if false; // 재생 로직 붙기 전까지 미생성/미사용
      }
    }
  }
}
