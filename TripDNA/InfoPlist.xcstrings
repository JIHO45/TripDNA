    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TripDNA saves your share cards to Photos so you can keep or share them."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지문·여행·Wrapped 공유 카드를 사진첩에 저장해 보관하거나 공유할 수 있어요."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TripDNA reads photo dates and locations on this device to find past trips and lets you choose a photo for each travel day. Photos stay on your device."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 안 사진의 날짜와 위치로 지난 여행을 찾고, 여행한 날마다 사진을 고를 수 있게 해요. 사진은 기기 밖으로 보내지 않아요."
          }
        }
      }
    }
  },
  "version" : "1.0"
